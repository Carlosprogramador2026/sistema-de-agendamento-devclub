      "Bash(git commit -m ' *)",
      "Bash(gh repo *)",
      "Bash(echo \"EXIT:$?\")",
      "Bash(npx --yes playwright --version)",
      "Bash(powershell -Command \"Stop-Process -Id 17256 -Force\")",
